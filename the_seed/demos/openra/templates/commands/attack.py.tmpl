try:
    _step_messages = []
    global_attack = $global_attack
    if global_attack:
        attackers = api.query_combat_units()
    else:
        attackers = api.query_actor($attackers)
    targets = api.query_actor($targets)
    if not attackers:
        raise RuntimeError("未找到攻击者")
    if not targets:
        if global_attack:
            api.dispatch_attack(attackers)
        else:
            raise RuntimeError("未找到攻击目标")
    else:
        target = targets[0]
        if global_attack:
            priority = {"建造厂": 0, "矿场": 1, "战车工厂": 2, "雷达站": 3, "兵营": 4}
            target = min(
                targets,
                key=lambda a: priority.get(str(getattr(a, "type", "") or ""), 999),
            )
        api.dispatch_attack(attackers, target)
    logger.info("已下达攻击指令")
    _step_messages.append("已下达攻击指令")
    __result__ = {
        "success": True,
        "message": _step_messages[-1],
        "observations": ""
    }
except Exception as e:
    __result__ = {
        "success": False,
        "message": f"执行失败: {e}",
        "observations": ""
    }
